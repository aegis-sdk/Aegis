shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# The publish token is NOT kept here — reading this file when NPM_TOKEN is
# unset causes a warning on every pnpm invocation. The publish workflow
# writes its own auth line via `npm config set` or an ephemeral .npmrc
# (see .github/workflows/publish.yml), which is the more common pattern.
